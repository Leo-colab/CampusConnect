# Optional: add an OpenAI API key to enable live image understanding and AI assistant responses.
# Never put this key in client-side code or commit your real .env file.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
MONGODB_DB_NAME=campusconnect
